{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OAuth Diagnostic Tool",
  "version": "0.0.5",
  "identifier": "com.ldaIas.oauth-diag-tool",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "cd ui && elm make src/Main.elm --output dist/main.js",
    "beforeBuildCommand": "cd ui && elm make src/Main.elm --optimize --output dist/main.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OAuth Tool",
        "width": 1400,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGMjIwNTgwOEFDRjdGRTMKUldUamY4K0tnQVVpcjA4VjVpWlZ4cGQ5VTZSSjlSMHBEVjV0VzBsWHNtTElFQnp2eFc3bWRzN04K",
      "endpoints": ["https://github.com/ldaIas/oauth-diag-tool/releases/latest/download/latest.json"]
    }
  }
}
