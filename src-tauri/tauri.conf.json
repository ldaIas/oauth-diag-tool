{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OAuth Diagnostic Tool",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "cd ui && elm make src/Main.elm --output dist/main.js",
    "beforeBuildCommand": "cd ui && elm make src/Main.elm --output dist/main.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OAuth Tool",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
